{
  "name": "codewave",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/providers/*"
  ],
  "scripts": {
    "dev": "npm run build:web && tsx apps/daemon/src/index.ts",
    "dev:web": "npm run dev -w @codewave/web",
    "build:web": "npm run build -w @codewave/web",
    "check": "npm run check:types && npm run check:acp && npm run check:acp-provider && npm run check:acp-custom && npm run check:worktrees",
    "check:types": "tsc --noEmit",
    "check:shell": "tsx scripts/validate-shell-usability.ts",
    "check:providers": "tsx scripts/validate-provider-policy.ts",
    "check:freebuff": "tsx scripts/validate-freebuff-bridge.ts",
    "check:mcp": "tsx scripts/validate-mcp-observer.ts",
    "check:mcp:e2e": "tsx scripts/validate-mcp-daemon-e2e.ts",
    "check:runtime": "tsx scripts/validate-provider-runtime.ts",
    "check:transport": "tsx scripts/validate-structured-transport.ts",
    "check:acp": "tsx scripts/validate-acp-v1.ts",
    "check:acp-provider": "tsx scripts/validate-generic-acp-provider.ts",
    "check:acp-custom": "tsx scripts/validate-custom-acp-profile.ts",
    "check:worktrees": "tsx scripts/validate-project-worktrees.ts",
    "check:harness": "node scripts/validate-daemon-harness.mjs",
    "check:adversarial": "node scripts/validate-daemon-adversarial.mjs",
    "check:continuity": "node scripts/validate-continuity.mjs",
    "check:registrations": "node scripts/validate-registration-signals.mjs",
    "check:registrations:json": "node scripts/validate-registration-signals.mjs --summary-json artifacts/registration-summary.json"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^24.6.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
