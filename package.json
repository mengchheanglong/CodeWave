{
  "name": "codewave",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/providers/*"
  ],
  "scripts": {
    "dev": "npm run build:web && tsx apps/daemon/src/index.ts",
    "dev:web": "npm run dev -w @codewave/web",
    "dev:desktop": "npm run start -w @codewave/desktop",
    "build:web": "npm run build -w @codewave/web",
    "build:desktop:icons": "electron scripts/generate-desktop-icons.cjs",
    "build:desktop": "npm run build:desktop:icons && npm run package -w @codewave/desktop",
    "check": "npm run check:types && npm run check:acp && npm run check:acp-provider && npm run check:acp-custom && npm run check:worktrees && npm run check:compaction && npm run check:budgets-trace && npm run check:desktop-daemon && npm run check:desktop-security && npm run check:desktop-demo",
    "check:types": "tsc --noEmit",
    "check:shell": "tsx scripts/validate-shell-usability.ts",
    "check:providers": "tsx scripts/validate-provider-policy.ts",
    "check:freebuff": "tsx scripts/validate-freebuff-bridge.ts",
    "check:mcp": "tsx scripts/validate-mcp-observer.ts",
    "check:mcp:e2e": "tsx scripts/validate-mcp-daemon-e2e.ts",
    "check:runtime": "tsx scripts/validate-provider-runtime.ts",
    "check:transport": "tsx scripts/validate-structured-transport.ts",
    "check:acp": "tsx scripts/validate-acp-v1.ts",
    "check:acp-provider": "tsx scripts/validate-generic-acp-provider.ts",
    "check:acp-custom": "tsx scripts/validate-custom-acp-profile.ts",
    "check:worktrees": "tsx scripts/validate-project-worktrees.ts",
    "check:compaction": "tsx scripts/validate-transcript-compaction-core.ts",
    "check:budgets-trace": "tsx scripts/validate-task-budgets-memory-trace.ts",
    "check:desktop-daemon": "tsx scripts/validate-desktop-daemon-runtime.ts",
    "check:harness": "node scripts/validate-daemon-harness.mjs",
    "check:adversarial": "node scripts/validate-daemon-adversarial.mjs",
    "check:continuity": "node scripts/validate-continuity.mjs",
    "check:desktop-security": "tsx scripts/validate-desktop-security.ts",
    "check:desktop-demo": "tsx scripts/validate-desktop-demo.ts",
    "check:registrations": "node scripts/validate-registration-signals.mjs",
    "check:registrations:json": "node scripts/validate-registration-signals.mjs --summary-json artifacts/registration-summary.json"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "^24.6.0",
    "electron": "43.4.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
